    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}


@model List<Product>

<div class="page-container">

    <h2>Products</h2>

    <a asp-controller="Product" asp-action="Create" class="add-link">
        Add New Product
    </a>

    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>CategoryId</th>
            <th>SupplierId</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m => item.Id)</td>
                <td>@Html.DisplayFor(m => item.Name)</td>
                <td>@Html.DisplayFor(m => item.Price)</td>
                <td>@Html.DisplayFor(m => item.Quantity)</td>
                <td>@Html.DisplayFor(m => item.CategoryId)</td>
                <td>@Html.DisplayFor(m => item.SupplierId)</td>
            </tr>
        }

    </table>

</div>
