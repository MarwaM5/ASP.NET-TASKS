@{
}

@model List<Category>

<div class="page-container">

    <h2>Categories</h2>

    <a asp-controller="Category" asp-action="Create" class="add-link">
        Add New Category
    </a>

    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m => item.Id)</td>
                <td>@Html.DisplayFor(m => item.Name)</td>
                <td>@Html.DisplayFor(m => item.Description)</td>
            </tr>
        }

    </table>

</div>