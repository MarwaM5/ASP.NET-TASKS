@model SupplyRequest

@{
    ViewData["Title"] = "Edit Request";
}

<h2>Edit Request Status</h2>

<div>
    <p><strong>Request ID:</strong> @Model.Id</p>
    <p><strong>Current Status:</strong> @Model.Status</p>
    <p><strong>Total Price:</strong> @Model.TotalPrice JD</p>
</div>

<form asp-action="Edit" method="post">

    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Request Status</label>

        <select name="status" class="form-select">
            <option value="Pending"
                    selected="@(Model.Status == "Pending")">
                Pending
            </option>

            <option value="Approved"
                    selected="@(Model.Status == "Approved")">
                Approved
            </option>

            <option value="Rejected"
                    selected="@(Model.Status == "Rejected")">
                Rejected
            </option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
