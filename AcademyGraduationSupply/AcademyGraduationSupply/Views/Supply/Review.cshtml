@model List<AcademyGraduationSupply.Models.Category>

<h2>Review Supply Request</h2>

<table border="1" cellpadding="8">
    <tr>
        <th>Category</th>
        <th>Supplier</th>
        <th>Offer</th>
        <th>Quantity</th>
        <th>Unit Price</th>
        <th>Total Price</th>
    </tr>

    @foreach (var category in Model)
    {
        @foreach (var supplier in category.Suppliers)
        {
            <tr>
                <td>@category.Name</td>
                <td>@supplier.Name</td>
                <td>@supplier.Offer.Name</td>
                <td>@supplier.Offer.Quantity</td>
                <td>@supplier.Offer.UnitPrice JD</td>
                <td>@ViewBag.OfferTotals[supplier.Offer.Id] JD</td>
            </tr>
        }
    }
</table>

<h3>Cost Summary</h3>

<p>Total Price: @ViewBag.TotalPrice JD</p>
<p>Discount: @ViewBag.DiscountPercent%</p>
<p>Discount Amount: @ViewBag.DiscountAmount JD</p>

<h3>Final Total: @ViewBag.FinalTotal JD</h3>

