@model List<AcademyGraduationSupply.Models.Category>

<h2>Create Supply Request</h2>

@if (TempData["Error"] != null)
{
    <p style="color:red">@TempData["Error"]</p>
}

<form asp-controller="Supply" asp-action="Create" method="post">

    @foreach (var category in Model)
    {
        <h3>@category.Name</h3>

        <table border="1" cellpadding="8">
            <tr>
                <th>Select</th>
                <th>Supplier</th>
                <th>Offer</th>
                <th>Quantity</th>
                <th>Unit Price</th>
            </tr>

            @foreach (var supplier in category.Suppliers)
            {
                <tr>
                    <td>
                        <input type="radio"
                               name="category@(category.Id)"
                               value="@supplier.Offer.Id"
                               required />
                    </td>

                    <td>@supplier.Name</td>
                    <td>@supplier.Offer.Name</td>
                    <td>@supplier.Offer.Quantity</td>
                    <td>@supplier.Offer.UnitPrice JD</td>
                </tr>
            }
        </table>
    }

    <br />
    <button type="submit">Review Request</button>

</form>
