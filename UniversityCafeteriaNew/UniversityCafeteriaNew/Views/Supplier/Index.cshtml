@{
}
@model List<Supplier>

<h2>Suppliers</h2>

<a asp-action="Create" class="add-new-button">Add New Supplier</a>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Address</th>
        <th>Products Count</th>
        <th>Actions</th>
    </tr>

    @foreach (var supplier in Model)
    {
        <tr>
            <td>@supplier.Id</td>
            <td>@supplier.Name</td>
            <td>@supplier.Phone</td>
            <td>@supplier.Email</td>
            <td>@supplier.Address</td>
            <td>@supplier.Products.Count</td>
             <td>
                <div class="action-buttons">

                    <a asp-action="Details" asp-route-id="@supplier.Id"
                       class="btn-details">Details</a>

                    <a asp-action="Edit" asp-route-id="@supplier.Id"
                       class="btn-edit">Edit</a>

                    <form asp-action="Delete" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this supplier?')">

                        <input type="hidden" name="id" value="@supplier.Id" />

                        <button type="submit" class="btn-delete">Delete</button>

                    </form>

                </div>
            </td>
        </tr>
    }
</table>
