@{
}
@model Product

<h2>Edit Product</h2>

<form method="post" asp-action="Edit">

    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Name</label>
    <input type="text" name="Name" value="@Model.Name" />

    <br /><br />

    <label>Description</label>
    <input type="text" name="Description" value="@Model.Description" />

    <br /><br />

    <label>Price</label>
    <input type="number"  name="Price" value="@Model.Price" />

    <br /><br />

    <label>Quantity</label>
    <input type="number" name="Quantity" value="@Model.Quantity" />

    <br /><br />

    <label>Category</label>
    <select name="CategoryId">
        @foreach (var item in ViewBag.Categories)
        {
            if (item.Id == Model.CategoryId)
            {
                <option value="@item.Id" selected>@item.Name</option>
            }
            else
            {
                <option value="@item.Id">@item.Name</option>
            }
        }
    </select>

    <br /><br />

    <label>Supplier</label>
    <select name="SupplierId">
        @foreach (var item in ViewBag.Suppliers)
        {
            if (item.Id == Model.SupplierId)
            {
                <option value="@item.Id" selected>@item.Name</option>
            }
            else
            {
                <option value="@item.Id">@item.Name</option>
            }
        }
    </select>

    <br /><br />

    <button type="submit">Save</button>

</form>